#!/bin/sh
set -eu
TASK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$TASK_ROOT"
if [ ! -x .venv/bin/python ]; then
  if ! command -v uv >/dev/null 2>&1; then HOMEBREW_NO_AUTO_UPDATE=1 brew install uv; fi
  uv sync --frozen
fi
exec "$TASK_ROOT/.venv/bin/python" "$TASK_ROOT/scripts/demo_runner.py" "$@"
